# =============================================================================
# Fab Bottleneck & Supply Chain Risk Advisor — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env — it is in .gitignore
# =============================================================================

# ── IBM Bob / watsonx.ai ──────────────────────────────────────────────────────
# Required for AI narration. If not set, app uses deterministic fallback.
BOB_API_KEY=your_ibm_cloud_api_key_here
BOB_PROJECT_ID=your_watsonx_project_id_here
BOB_API_URL=https://us-south.ml.cloud.ibm.com/ml/v1/text/generation
BOB_MODEL_ID=ibm/granite-13b-instruct-v2
BOB_MAX_TOKENS=600

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL / Supabase connection string.
# If not set, app runs in demo mode with built-in synthetic data.
DATABASE_URL=postgresql://user:password@localhost:5432/fab_risk_db

# ── Application ───────────────────────────────────────────────────────────────
APP_PORT=8000
APP_ENV=development

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173

# ── Frontend ──────────────────────────────────────────────────────────────────
# Only needed if running frontend against a non-proxied backend.
# When using the Vite dev server proxy, leave this commented out.
# VITE_API_BASE_URL=http://localhost:8000/api/v1
