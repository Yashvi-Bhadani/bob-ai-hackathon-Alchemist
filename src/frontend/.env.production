# Production API base URL — points to the live Render backend.
# Vite substitutes this at build time so all fetch() calls in the
# compiled bundle use the absolute Render URL instead of the
# relative /api/v1 fallback (which only works with the local dev proxy).
#
# If you also set VITE_API_BASE_URL in the Vercel environment variables
# dashboard, that value takes precedence over this file.
VITE_API_BASE_URL=https://fabriskadvisor.onrender.com/api/v1
